# Example environment configuration for reqly-sync-server.
# Copy to .env and fill in real values. Variables marked REQUIRED must be set
# for the server to work in production; optional ones have sane defaults.

# ── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED (production). HMAC secret for signing session tokens / WS tickets.
# Generate with: openssl rand -hex 32. The server refuses to start in
# production without it.
AUTH_SIGNING_SECRET=

# ── GitHub OAuth (audit 2026-08) ───────────────────────────────────────────
# Client credentials for the GitHub OAuth login / tool-integration flows.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# SECURITY (audit H1): strict allowlist of redirect URIs accepted by
# POST /api/auth/github-exchange. Defaults shown; override only if you add
# legitimate new callback targets.
# GITHUB_OAUTH_REDIRECT_WEB=https://reqly-app.duckdns.org/api/github-auth/callback
# GITHUB_OAUTH_REDIRECT_DESKTOP=http://127.0.0.1:18234/callback

# Optional (default false). Set to "true" to disable ALL authentication.
# FORBIDDEN in production — the server refuses to start if NODE_ENV=production.
AUTH_BYPASS=false

# ── CORS ───────────────────────────────────────────────────────────────────
# Optional. Comma-separated list of allowed origins, or "*" for wildcard
# (wildcard disables cookie credentials and logs a loud warning in prod).
# Unset → local dev defaults (localhost:3000/4173, tauri://localhost).
ALLOWED_ORIGIN=

# ── HTTP server ────────────────────────────────────────────────────────────
# Optional (default 4000).
PORT=4000

# Optional (default "0.0.0.0").
HOST=0.0.0.0

# Optional (default false). Set "true" only when behind a reverse proxy that
# overwrites X-Forwarded-For, to rate-limit on the client IP.
TRUSTED_PROXY=false

# Standard Node environment. "production" enables secure cookies, strict
# email defaults and boot-time config guards. Optional (default development).
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────
# Optional. Path of the SQLite file ("data/reqly-sync.db" relative to cwd),
# or ":memory:" for an ephemeral in-memory DB.
REQLY_DB_PATH=data/reqly-sync.db

# ── Email ──────────────────────────────────────────────────────────────────
# Optional. One of: smtp | resend | log.
# Default: "log" in development, "smtp" in production.
EMAIL_PROVIDER=log

# Optional (default noreply@reqly.app). From address shown to recipients.
EMAIL_FROM="Reqly <noreply@reqly.app>"

# Required when EMAIL_PROVIDER=smtp:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Required when EMAIL_PROVIDER=resend:
RESEND_API_KEY=
