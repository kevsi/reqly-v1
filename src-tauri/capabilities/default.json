{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/Reqly/**", "$APPDATA/com.reqly.app/**"]
    },
    "deep-link:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "notification:default",
    "allow-fetch-proxy",
    "allow-export-json",
    "allow-open-external",
    "allow-start-capture-proxy",
    "allow-stop-capture-proxy",
    "allow-start-mcp-server",
    "allow-stop-mcp-server",
    "allow-get-mcp-server-status",
    "allow-read-mcp-bundle",
    "allow-sync-mcp-collections",
    "allow-save-file",
    "allow-list-captured-sessions",
    "allow-get-captured-session",
    "allow-clear-captured-sessions",
    "allow-set-bandwidth-limit",
    "allow-enqueue-request",
    "allow-list-pending",
    "allow-dequeue-ready",
    "allow-mark-sent",
    "allow-git-init",
    "allow-git-open",
    "allow-git-status",
    "allow-git-log",
    "allow-git-commit",
    "allow-git-stage",
    "allow-git-stage-all",
    "allow-git-unstage",
    "allow-git-diff",
    "allow-git-branch-list",
    "allow-git-branch-create",
    "allow-git-branch-delete",
    "allow-git-branch-switch",
    "allow-git-remote-list",
    "allow-git-remote-add",
    "allow-git-remote-remove",
    "allow-git-push",
    "allow-git-push-force",
    "allow-git-fetch",
    "allow-git-pull",
    "allow-git-clone",
    "allow-git-sync-collections",
    "allow-git-write-collection-file",
    "allow-git-ls-remote",
    "allow-get-encryption-passphrase",
    "allow-exchange-oauth-code",
    "allow-get-oauth-client-id"
  ]
}
