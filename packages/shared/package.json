{
  "name": "@reqly/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./curl-parser": {
      "types": "./dist/curl-parser/index.d.ts",
      "default": "./dist/curl-parser/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    },
    "./assertions": {
      "types": "./dist/assertions/index.d.ts",
      "default": "./dist/assertions/index.js"
    },
    "./variable-path": {
      "types": "./dist/variable-path/index.d.ts",
      "default": "./dist/variable-path/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
