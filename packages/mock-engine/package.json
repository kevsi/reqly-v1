{
  "name": "@reqly/mock-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "default": "./dist/generator.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/scripts-child.mjs', 'dist/scripts-child.mjs')\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
