# 🔐 SECURITY: Deployment type flag (web or desktop)
# Set to "web" for public web deployment (disables desktop-only endpoints like /api/test-runner)
# Set to "desktop" for Tauri desktop app (allows all endpoints)
NEXT_PUBLIC_DEPLOYMENT_TYPE=desktop

# 🔐 SECURITY: Auth signing secret for JWT operations
# Generate with: openssl rand -base64 32
# Minimum 32 characters. Store in AWS Secrets Manager, not .env.local
AUTH_SIGNING_SECRET=your_auth_signing_secret_32_chars_min

# 🔐 SECURITY: Service token for internal proxy authentication
# Generate with: openssl rand -base64 32
# Used to authenticate sidecar ↔ API calls. Minimum 32 characters.
PROXY_SERVICE_TOKEN=your_proxy_service_token_32_chars_min

GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
# Desktop OAuth (Reqly app): a dedicated OAuth app whose "Authorization
# callback URL" is `http://127.0.0.1` (loopback, any port). If unset, the
# desktop flow falls back to GITHUB_OAUTH_CLIENT_ID/SECRET above (works only
# if that app's callback URL is a loopback URL).
GITHUB_OAUTH_DESKTOP_CLIENT_ID=
GITHUB_OAUTH_DESKTOP_CLIENT_SECRET=
GITLAB_OAUTH_DESKTOP_CLIENT_ID=
GITLAB_OAUTH_DESKTOP_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Supabase Auth
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Distributed rate limiter (optional — falls back to in-memory if absent)
# Create a free Redis at https://upstash.com and paste the REST credentials here.
# Required on serverless/Edge deployments for the rate limit to be effective
# across instances; on a single Node self-host the in-memory limiter is fine.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Jina AI provider key
JINA_API_KEY=your_jina_api_key

# ── Proxy & SSRF hardening ────────────────────────────────────────────────
# Set to "true" ONLY when running behind a trusted reverse proxy (Vercel/Fly)
# that overwrites X-Forwarded-For. Enables per-client rate-limit bucketing.
TRUSTED_PROXY=false

# Set to "true" to allow requests to localhost/private IPs through the proxy
# routes (local development only — never enable on a public deployment).
ALLOW_LOCAL_HOSTS=false

# Optional: comma-separated list of extra allowed origins for /api/proxy-sse.
ALLOWED_ORIGIN=

# Optional: base URL the test-runner uses to reach this API's proxy endpoint
# (defaults to the incoming request origin when unset).
NEXT_PUBLIC_API_URL=

# Public base URL of this app (used to build OAuth redirect URLs and
# invitation links; falls back to http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the sync service. REQUIRED on public web deployments:
# capture authentication (/api/capture/*, /api/proxy) validates tokens
# against `${NEXT_PUBLIC_SYNC_URL}/api/auth/me`.
NEXT_PUBLIC_SYNC_URL=https://reqly.duckdns.org

# ── Supabase (server-side) ────────────────────────────────────────────────
# Server-side Supabase project URL paired with SUPABASE_SERVICE_ROLE_KEY
# above. Without both, captured sessions fall back to in-memory storage
# and are lost on restart.
SUPABASE_URL=https://your-project.supabase.co

# ── OAuth providers ───────────────────────────────────────────────────────
# GitLab sign-in (web deployment)
GITLAB_OAUTH_CLIENT_ID=your_gitlab_oauth_client_id
GITLAB_OAUTH_CLIENT_SECRET=your_gitlab_oauth_client_secret

# Optional: GitHub token raising API rate limits for /api/github-import.
GITHUB_TOKEN=

# ── Capture service ───────────────────────────────────────────────────────
# Shared secret required by POST /api/capture/cleanup (scheduled cleanup).
CAPTURE_CLEANUP_SECRET=your_capture_cleanup_secret_32_chars_min

# Optional: webhook URL to forward Content-Security-Policy reports to
# (see app/api/csp-reports/route.ts).
CSP_WEBHOOK_URL=

# ── AI providers & tooling ────────────────────────────────────────────────
# Optional: port of a local Ollama server (default 11434).
OLLAMA_PORT=11434

# Optional: OpenAPI generator backend used by /api/sdk-generate.
OPENAPI_GENERATOR_URL=https://api.openapi-generator.tech/api/gen/clients

# Optional: directory holding tree-sitter WASM binaries (defaults shipped
# with the app; see lib/tree-sitter-parser.ts).
TREE_SITTER_WASM_DIR=

# Usage: copy .env.example to .env.local and fill with real secrets. Do NOT commit .env.local.
