{
  "name": "recli",
  "version": "0.1.0",
  "description": "Recli \u2014 API testing CLI for Reqly (headless/CI, TUI, MCP server). Distributed via the Reqly desktop app sidecar.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevsi/reqly-v1.git"
  },
  "homepage": "https://github.com/kevsi/apiPlayground/tree/main/recli",
  "keywords": [
    "api",
    "testing",
    "cli",
    "tui",
    "postman",
    "newman",
    "collection",
    "mcp",
    "openapi",
    "assertions",
    "graphql"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@reqly/shared": "workspace:*",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.2.0",
    "@reqly/mock-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
